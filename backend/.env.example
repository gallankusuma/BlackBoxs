PORT=3005

# MySQL
DB_HOST=localhost
DB_USER=erp_user
DB_PASSWORD=
DB_NAME=blackboxs

NODE_ENV=development

# Wajib diganti di production
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Password akun master (master@admin.com).
#
# Dulu nilainya ditulis langsung di kode sebagai 'master' — di repo publik, jadi
# siapa pun bisa login sebagai master penuh. Sekarang HARUS dari sini.
#
# Kosong = jalur login master NONAKTIF (fail closed). Nilai 'master' juga
# ditolak karena sudah terlanjur publik. Minimal 12 karakter.
MASTER_PASSWORD=

# Opsional — dipakai /api/ai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Origin yang boleh memanggil API (pisah koma). Kosong = default per NODE_ENV
CORS_ORIGINS=

# Password admin awal saat seed database baru. Kosong = digenerate acak
# dan ditampilkan sekali di log boot.
SEED_ADMIN_PASSWORD=

# Batas percobaan login per 15 menit. Kosong = 20 di production, 500 di dev
AUTH_RATE_LIMIT_MAX=

# Batas request /api per menit. Kosong = 300 di production, 5000 di dev
API_RATE_LIMIT_MAX=
GERBANG_SCOPE_LENGKAP=false
ESTIMATOR_RBAC=false

# gemini (default) | openai — penyedia utama pembacaan gambar & diskusi MTO.
# Yang tidak tersedia otomatis dilewati.
AI_VISION_PROVIDER=gemini
