PORT=3005

# MySQL
DB_HOST=localhost
DB_USER=erp_user
DB_PASSWORD=
DB_NAME=erp_genjaya

NODE_ENV=development

# Wajib diganti di production
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Opsional — dipakai /api/ai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Origin yang boleh memanggil API (pisah koma). Kosong = default per NODE_ENV
CORS_ORIGINS=

# Password admin awal saat seed database baru. Kosong = digenerate acak
# dan ditampilkan sekali di log boot.
SEED_ADMIN_PASSWORD=
